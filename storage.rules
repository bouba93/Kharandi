rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    
    // Règles pour les tickets de support
    match /tickets/{userId}/{fileName} {
      // Lecture : L'utilisateur peut lire ses propres fichiers, le Super Admin peut tout lire
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "boubabatuta@gmail.com");
      
      // Écriture : Seul le propriétaire peut uploader
      // Limite de taille : 5MB (5 * 1024 * 1024 octets)
      // Types autorisés : Images (jpeg, png, webp) et PDF
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Règles par défaut : refuser tout le reste
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
